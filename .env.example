# IcchaStore Production Environment Configuration
# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/icchastore_db?schema=public"

# Auth Secrets & Session Expiry
AUTH_SECRET="your-super-secret-auth-key-32-chars-min"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage & Media Abstraction (S3 / Cloudflare R2 / Google Cloud Storage / Local)
STORAGE_PROVIDER="LOCAL"
STORAGE_PUBLIC_BUCKET="icchastore-public-media"
STORAGE_PRIVATE_BUCKET="icchastore-private-documents"
STORAGE_REGION="ap-south-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
CDN_BASE_URL=""

# Media Upload Thresholds
MEDIA_MAX_IMAGE_MB="15"
MEDIA_MAX_VIDEO_MB="50"

# Communication & Notifications (SMTP / WhatsApp)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="orders@icchastore.com"

WHATSAPP_PROVIDER="MOCK"
WHATSAPP_API_URL="https://graph.facebook.com/v19.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_SENDER="+919829012345"
WHATSAPP_ORDER_TEMPLATE="iccha_order_confirmation_v1"
